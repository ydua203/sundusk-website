# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.
# Full instructions: CLAUDE.md section 4.

# --- Supabase ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> Database -> Connection string -> URI
# Use the Transaction pooler (port 6543), not the direct connection (5432).
DATABASE_URL=

# --- Razorpay ---
# Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks (set when the webhook is created, day 7)
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Resend ---
RESEND_API_KEY=
EMAIL_FROM="Sundusk <hello@sundusk.in>"
EMAIL_REPLY_TO=hellosundusk.in@gmail.com

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAILS=email1@example.com,email2@example.com
